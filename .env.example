# Recommended: let the server generate short-lived Apple Music developer tokens.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=

# Paste the contents of your Apple Media Services .p8 private key into Vercel as a secret.
# Never commit the real key to GitHub.
APPLE_MUSIC_PRIVATE_KEY=

# Optional alternative: provide a pre-generated signed Apple Music developer JWT instead.
# If this is set, it takes precedence over the three values above.
APPLE_MUSIC_DEVELOPER_TOKEN=
