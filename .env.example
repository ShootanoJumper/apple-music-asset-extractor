# YouTube worker (recommended setup)
# Example: https://your-worker.up.railway.app
MEDIA_WORKER_URL=

# Use the exact same random secret in Vercel and Railway.
# Do not commit a real value here.
MEDIA_WORKER_SECRET=

# Optional Apple Music developer credentials.
# These are NOT required for public Apple metadata/artwork/preview extraction.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_DEVELOPER_TOKEN=
